# GhostLock / HolmeSwap — Arbitrum-first (copy to .env)

VITE_APP_NAME=GhostLock: MEV Reaper
VITE_APP_VERSION=1.0.0
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Default wallet network
VITE_CHAIN_ID=421614
VITE_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
VITE_ARBITRUM_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Optional: override USDC ERC-20 (default = Circle canonical per chain)
# Arbitrum Sepolia: 0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# VITE_ARBITRUM_SEPOLIA_USDC_ADDRESS=
# VITE_MOCK_USDC_ADDRESS=

# GhostLock cluster — Arbitrum Sepolia (see contracts/README.md)
VITE_ARBITRUM_SEPOLIA_GHOSTLOCK_LIVENESS_ADDRESS=0x9c3772c9B2E8ae8A074aa9Fc8Aaa4943e0ffC983
VITE_ARBITRUM_SEPOLIA_EPOCH_RNG_ADDRESS=0x73A35514Ab9405381A323c513220e20ACb9d7c30
VITE_ARBITRUM_SEPOLIA_DRAND_BEACON_ADDRESS=0x74FBA5163505e43634F366c52C92824C23027076
VITE_ARBITRUM_SEPOLIA_PRICE_ORACLE_ADDRESS=0x86c4023741467c3179683ed152471921DC2D48BC
VITE_ARBITRUM_SEPOLIA_SOLVER_REGISTRY_ADDRESS=0x3302E3d04d166C6D23E5B09a29a8eE3d2C7Baf98
VITE_ARBITRUM_SEPOLIA_SOLVER_BOARD_ADDRESS=0xB1A20FFFf4E4e15c0735fc0a79ad8BB8F3909916
VITE_ARBITRUM_SEPOLIA_BATCH_SETTLEMENT_ADDRESS=0x926349E53527f690E25CF9C5d60e8791985aD14E

# Legacy aliases (optional)
VITE_GHOSTLOCK_LIVENESS_ADDRESS=
VITE_GHOSTLOCK_EPOCH_RNG_ADDRESS=

# Arbitrum One — set after mainnet deploy
VITE_ARBITRUM_ONE_GHOSTLOCK_LIVENESS_ADDRESS=
VITE_ARBITRUM_ONE_EPOCH_RNG_ADDRESS=
VITE_ARBITRUM_ONE_PRICE_ORACLE_ADDRESS=
VITE_ARBITRUM_ONE_SOLVER_REGISTRY_ADDRESS=
VITE_ARBITRUM_ONE_SOLVER_BOARD_ADDRESS=
VITE_ARBITRUM_ONE_BATCH_SETTLEMENT_ADDRESS=

# drand quicknet tlock for ENCRYPT (primary; set to 1 to use submitTlockIntentWithBond)
VITE_USE_TLOCK=1

# dcipher infrastructure (legacy ENCRYPT; optional when VITE_USE_TLOCK=1)
VITE_BLOCKLOCK_SENDER_ARB_SEPOLIA=0xd22302849a87d5B00f13e504581BC086300DA080
VITE_BLOCKLOCK_SENDER_ARB_MAINNET=0x78ebbbc39f7244bE80C76f11248f5a2645978e25
VITE_RANDOMNESS_SENDER_ARB_SEPOLIA=0xf4e080Db4765C856c0af43e4A8C4e31aA3b48779
VITE_RANDOMNESS_SENDER_ARB_MAINNET=0x3BF0529293ff2F1901B2f301e56447Dcd56CBaF9

# After ADKG ceremony — JSON BlocklockPublicKey for client encrypt (see docs/DCIPHER-OPS.md)
# VITE_BLOCKLOCK_IBE_PUBLIC_KEY={"x":{"c0":"...","c1":"..."},"y":{"c0":"...","c1":"..."}}
# Force blocklock-js network profile (e.g. 421614 when wallet is 42161 until mainnet profile exists)
# VITE_BLOCKLOCK_NETWORK_CHAIN_ID=421614

VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOLVER_API_URL=http://localhost:4000/api/auctions
VITE_INDEXER_URL=http://localhost:4000/api
