# Server Configuration
PORT=4800
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Arbitrum Sepolia (421614)
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Optional: dedicated endpoint for eth_getLogs (watcher + solver batch scan). Falls back to RPC_URL.
LOG_RPC_URL=
CHAIN_ID=421614

# Cluster (Sep 2026 deploy)
GHOSTLOCK_LIVENESS_ADDRESS=0x9c3772c9B2E8ae8A074aa9Fc8Aaa4943e0ffC983
BATCH_SETTLEMENT_ADDRESS=0x926349E53527f690E25CF9C5d60e8791985aD14E
EPOCH_RNG_ADDRESS=0x73A35514Ab9405381A323c513220e20ACb9d7c30
DRAND_BEACON_ADDRESS=0x74FBA5163505e43634F366c52C92824C23027076
SOLVER_REGISTRY_ADDRESS=0x3302E3d04d166C6D23E5B09a29a8eE3d2C7Baf98
SOLVER_BOARD_ADDRESS=0xB1A20FFFf4E4e15c0735fc0a79ad8BB8F3909916
PRICE_ORACLE_ADDRESS=0x86c4023741467c3179683ed152471921DC2D48BC

# Solver (optional — read-only without key)
SOLVER_PRIVATE_KEY=
SOLVER_ENDPOINT_URL=http://localhost:4800/api/auctions/solver/status

# External APIs — server only. Never copy these into a VITE_ variable.
# Copy values into server/.env (this file is not loaded at runtime).
PRICE_FEED_PROVIDER=coinbase
# Pyth only — do not point this at Hermes when PROVIDER=coinbase (Coinbase uses COINBASE_API_URL).
PRICE_FEED_BASE_URL=
PYTH_BASE_URL=https://hermes.pyth.network
COINBASE_API_URL=https://api.exchange.coinbase.com
PRICE_FEED_API_KEY=
# Required for PRICE_FEED_PROVIDER=pyth and for GET /api/oracle/hermes/latest (UI proxy).
PYTH_API_KEY=
ETHERSCAN_API_KEY=
ANKR_API_KEY=
OPENAI_API_KEY=
INDEXER_URL=
# Optional keyed RPC for this process. No API key in a browser-facing URL.
# ARBITRUM_ONE_RPC_URL=

# AI/Agent configuration (optional)
AI_ENABLED=false
AI_UPSTREAM_URL=
AI_TIMEOUT_MS=15000
