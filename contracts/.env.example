# ── drand EpochRNG anchor (set at deploy time) ────────────────────────────────
# Map GhostLock epoch N to drand evmnet round R:
#   roundForEpoch(epoch) = DRAND_ROUND_ANCHOR + (epoch - DRAND_EPOCH_ANCHOR) * DRAND_ROUNDS_PER_EPOCH
# Example: epoch 1000 -> round 12345678, 8 drand rounds (~24s) per 100-block epoch (~200s on Arb)
DRAND_EPOCH_ANCHOR=1000
DRAND_ROUND_ANCHOR=12345678
DRAND_ROUNDS_PER_EPOCH=8

